# ── Backend ───────────────────────────────────────────────────────────────────
APP_ENV=development
DEMO_MODE=true
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# IA del coach. Sin esta clave el chat responde con reglas deterministas.
GEMINI_API_KEY=
# Opcional: fija el modelo. Vacío = se descubre el mejor disponible en la cuenta.
GEMINI_MODEL=
# El agente LangChain de la SPEC-02 consume mucha memoria; en Render free debe
# quedar apagado (el chat usa el coach REST con las mismas herramientas).
ENABLE_LANGCHAIN_AGENT=false
# Opcional: base administrada. Sin esto se usa SQLite efímero y los datos que
# guarde el usuario se pierden en cada reinicio del servicio.
DATABASE_URL=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
